<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone build for the bundled chess engine (others/src).

    Kept separate from the module's root pom.xml, which is generated by the
    Simplicite platform and overwritten on every pull / sync.

      Build:  mvn -f others/pom.xml clean package
      Output: others/target/simfunpack-chess.jar   (classes + opening/book.txt)

    SimGameChess (module src/) invokes this engine by reflection, so the root
    module build has NO compile dependency on it. Deploy this jar onto the
    platform classpath (e.g. Tomcat WEB-INF/lib/) next to the module.
  -->

  <groupId>com.simplicite.modules</groupId>
  <artifactId>SimFunPack-chess</artifactId>
  <version>7.0-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>SimFunPack chess engine</name>
  <description>Standalone chess engine for the SimFunPack module</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <skipTests>true</skipTests>
  </properties>

  <build>
    <finalName>simfunpack-chess</finalName>
    <sourceDirectory>${project.basedir}/src</sourceDirectory>
    <!-- Package non-Java files sitting in the source tree (opening/book.txt) -->
    <resources>
      <resource>
        <directory>${project.basedir}/src</directory>
        <excludes>
          <exclude>**/*.java</exclude>
        </excludes>
      </resource>
    </resources>
  </build>

  <dependencies>
    <!-- BestMoveServlet uses jakarta.servlet.* (compile only, provided by the container; Tomcat 11 = Servlet 6.1) -->
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <version>6.1.0</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
</project>
